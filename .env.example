# Sitenin canlı adresi (sitemap, OG görselleri ve canonical linkler için)
NEXT_PUBLIC_SITE_URL=https://muhtelifkitap.com

# Supabase — Project Settings → API
# Boş bırakılırsa site data/catalog.ts içindeki yerel katalogla çalışır,
# iletişim formu ise "henüz yapılandırılmadı" mesajı verir.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sunucu tarafı, gizli: yönetim panelinde yönetici ekleme/silme (auth.admin) için.
# Vercel'de "Sensitive" olarak tanımlayın; asla NEXT_PUBLIC_ önekiyle kullanmayın.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Database Webhook → POST /api/revalidate (header: x-revalidate-secret)
# Uzun, rastgele bir değer verin: openssl rand -hex 32
REVALIDATE_SECRET=

# Vercel Cron → /api/keepalive (Vercel bu değeri Authorization başlığına kendisi ekler)
CRON_SECRET=
